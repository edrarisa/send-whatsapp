# Plantilla de configuración. Copiar a `.env` y llenar.
# El archivo `.env` real NUNCA se sube a git (está en .gitignore).

# Token permanente del usuario del sistema "WAPP Test"
# Configuración → Usuarios → Usuarios del sistema → WAPP Test → Generar token
WHATSAPP_TOKEN=

# ID del número desde el que se envía.
# NO es el número telefónico, es el ID interno de Meta (~15 dígitos).
# Se obtiene con: GET /{version}/{WABA_ID}/phone_numbers
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp Business Account ID (este ya lo tenemos)
WHATSAPP_WABA_ID=TU_WABA_ID

# Versión de la Graph API
GRAPH_API_VERSION=v21.0
